<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">

    <!--
        Light theme tokens.

        This file and Tokens.Dark.xaml must define exactly the same keys. ThemeManager swaps one
        for the other at runtime and every style resolves them with DynamicResource, so a key
        present in one file and absent from the other silently paints transparent rather than
        failing. ThemeTokenTests asserts the two key sets are identical.

        Every value here was checked with the WCAG relative luminance formula rather than by eye.
        Text tokens clear 4.5:1 on every surface they are used on; tokens that identify a control
        clear 3:1, which is what WCAG 1.4.11 asks of a non-text element.

        Container outlines are deliberately NOT held to 3:1. Border.Hairline draws card and
        section edges, which are decoration rather than controls, and forcing it to 3:1 produces
        the heavy ruled boxes this redesign exists to get away from. Border.Control,
        Input.Border and Scroll.Thumb do identify controls and are held to 3:1.

        The accent keys are placeholders. ThemeManager overwrites them at startup with shades
        derived from the real Windows accent, so these values are only ever seen if that fails.
    -->

    <!-- ================================================================ surfaces -->
    <!-- Three layers: the page sits behind cards, and sunken wells sit inside them. -->

    <SolidColorBrush x:Key="Surface.Page" Color="#F3F3F3" po:Freeze="True" />
    <SolidColorBrush x:Key="Surface.Card" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Surface.Sunken" Color="#F7F7F7" po:Freeze="True" />
    <SolidColorBrush x:Key="Surface.Overlay" Color="#FFFFFF" po:Freeze="True" />

    <!-- ================================================================= borders -->

    <SolidColorBrush x:Key="Border.Hairline" Color="#E4E4E4" po:Freeze="True" />
    <SolidColorBrush x:Key="Border.Control" Color="#8A8A8A" po:Freeze="True" />
    <SolidColorBrush x:Key="Border.Strong" Color="#6B6B6B" po:Freeze="True" />

    <!--
        Near black rather than accent coloured, and not a mistake: the ring has to stay visible
        drawn on top of an accent filled button, and an accent ring on an accent fill is
        invisible. Windows 11 does the same thing for the same reason. FocusInner is a hairline
        of the opposite value just inside it, so the ring also survives on a dark fill.
    -->
    <SolidColorBrush x:Key="Border.Focus" Color="#1A1A1A" po:Freeze="True" />
    <SolidColorBrush x:Key="Border.FocusInner" Color="#FFFFFF" po:Freeze="True" />

    <!-- ==================================================================== text -->

    <SolidColorBrush x:Key="Text.Primary" Color="#1A1A1A" po:Freeze="True" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#5A5A5A" po:Freeze="True" />

    <!-- Hint and explanatory copy. 5.33:1 on card, 4.97:1 on the sunken surface. -->
    <SolidColorBrush x:Key="Text.Tertiary" Color="#6B6B6B" po:Freeze="True" />

    <!-- Below AA on purpose. Disabled text is meant to read as unavailable. -->
    <SolidColorBrush x:Key="Text.Disabled" Color="#A0A0A0" po:Freeze="True" />

    <!--
        Monospace at full Text.Primary weight optically reads heavier than proportional text at
        the same value, so the system info block gets one notch softer.
    -->
    <SolidColorBrush x:Key="Text.Mono" Color="#3A3A3A" po:Freeze="True" />

    <!-- ================================================================== accent -->
    <!-- Overwritten at startup from the Windows accent. See ThemeManager.ApplyAccent. -->

    <SolidColorBrush x:Key="Accent.Fill" Color="#0060AC" po:Freeze="True" />
    <SolidColorBrush x:Key="Accent.Hover" Color="#00589E" po:Freeze="True" />
    <SolidColorBrush x:Key="Accent.Pressed" Color="#005090" po:Freeze="True" />
    <SolidColorBrush x:Key="Accent.Text" Color="#FFFFFF" po:Freeze="True" />

    <!-- A wash of the accent, for selected rows where a full strength fill would shout. -->
    <SolidColorBrush x:Key="Accent.Subtle" Color="#E4EFF9" po:Freeze="True" />

    <!-- ================================================================ controls -->

    <SolidColorBrush x:Key="Control.Fill" Color="#FDFDFD" po:Freeze="True" />
    <SolidColorBrush x:Key="Control.FillHover" Color="#F5F5F5" po:Freeze="True" />
    <SolidColorBrush x:Key="Control.FillPressed" Color="#EDEDED" po:Freeze="True" />
    <SolidColorBrush x:Key="Control.FillDisabled" Color="#F5F5F5" po:Freeze="True" />
    <SolidColorBrush x:Key="Control.BorderDisabled" Color="#DCDCDC" po:Freeze="True" />

    <!-- =================================================================== input -->

    <SolidColorBrush x:Key="Input.Fill" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Input.FillHover" Color="#FAFAFA" po:Freeze="True" />
    <SolidColorBrush x:Key="Input.Border" Color="#8A8A8A" po:Freeze="True" />
    <SolidColorBrush x:Key="Input.BorderHover" Color="#6B6B6B" po:Freeze="True" />

    <!-- Invalid input, used by the accent hex box. Not the same red as Status.Danger text. -->
    <SolidColorBrush x:Key="Input.BorderError" Color="#C42B1C" po:Freeze="True" />

    <!-- ==================================================================== list -->

    <SolidColorBrush x:Key="Row.Hover" Color="#F2F2F2" po:Freeze="True" />
    <SolidColorBrush x:Key="Row.Selected" Color="#E4EFF9" po:Freeze="True" />
    <SolidColorBrush x:Key="Row.SelectedInactive" Color="#ECECEC" po:Freeze="True" />
    <SolidColorBrush x:Key="Grid.Header" Color="#F7F7F7" po:Freeze="True" />
    <SolidColorBrush x:Key="Grid.Line" Color="#ECECEC" po:Freeze="True" />

    <!-- ============================================================== scrollbars -->

    <SolidColorBrush x:Key="Scroll.Track" Color="#00000000" po:Freeze="True" />
    <SolidColorBrush x:Key="Scroll.Thumb" Color="#8A8A8A" po:Freeze="True" />
    <SolidColorBrush x:Key="Scroll.ThumbHover" Color="#6B6B6B" po:Freeze="True" />

    <!-- ================================================================== status -->

    <SolidColorBrush x:Key="Status.Success" Color="#0B6A0B" po:Freeze="True" />
    <SolidColorBrush x:Key="Status.Warning" Color="#9D5D00" po:Freeze="True" />
    <SolidColorBrush x:Key="Status.WarningSurface" Color="#FFF8E8" po:Freeze="True" />
    <SolidColorBrush x:Key="Status.WarningBorder" Color="#EFD9A8" po:Freeze="True" />
    <SolidColorBrush x:Key="Status.Danger" Color="#B32519" po:Freeze="True" />

    <!-- =================================================================== swatch -->
    <!--
        The accent swatch grid draws user chosen colours, so its chrome must never be accent
        coloured: a blue ring around a grid of arbitrary colours, one of which may itself be
        blue, reads as part of the data. Neutral high contrast ring plus an inner keyline so it
        survives on a near black swatch as well as a near white one.
    -->
    <SolidColorBrush x:Key="Swatch.Border" Color="#8A8A8A" po:Freeze="True" />
    <SolidColorBrush x:Key="Swatch.BorderSelected" Color="#1A1A1A" po:Freeze="True" />
    <SolidColorBrush x:Key="Swatch.Keyline" Color="#FFFFFF" po:Freeze="True" />

</ResourceDictionary>
