<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Control templates.

        Every control here is fully retemplated rather than merely recoloured, and that is not
        gold plating. WPF's Aero2 templates hardcode their own gradients and their own trigger
        brushes, so setting Background or BorderBrush on a stock Button, ComboBox, TabItem,
        GroupBox or ListViewItem is either ignored or half applied. The classic symptom is a
        control that looks right until the pointer touches it and the blue Aero gradient
        reappears from inside the template.

        Two rules hold throughout:

        1. Every brush is referenced with DynamicResource, never StaticResource. StaticResource
           resolves once at load, so a theme swap would appear to work for controls created
           afterwards and not for the ones already on screen, which reads as random.
        2. Every rounded corner exists because the template root is a Border. WPF controls have
           no CornerRadius property.

        Focus is drawn as two borders on negative margins: a 2px ring in Border.Focus and a 1px
        keyline in Border.FocusInner just inside it. The keyline is what keeps the ring visible
        on an accent filled button, where a near black ring on a dark blue fill would otherwise
        vanish. Negative margins keep the ring outside the control without reserving layout
        space, so nothing shifts when focus arrives.
    -->

    <!-- ============================================================ base typography -->

    <!-- TextBlock does not derive from Control, so the font has to be set on both. -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource Surface.Page}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    </Style>

    <!-- ==================================================================== button -->

    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Body}" />
        <Setter Property="Height" Value="{DynamicResource Size.ControlHeight}" />
        <Setter Property="MinWidth" Value="{DynamicResource Size.ButtonMinWidth}" />
        <Setter Property="Margin" Value="{DynamicResource Space.ButtonGap}" />
        <Setter Property="Padding" Value="{DynamicResource Space.ControlPadding}" />
        <Setter Property="Background" Value="{DynamicResource Control.Fill}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />

        <!-- The stock dotted rectangle is replaced by the ring drawn inside the template. -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="FocusRing" Margin="-3" CornerRadius="{DynamicResource Radius.Focus}"
                                BorderThickness="2" BorderBrush="{DynamicResource Border.Focus}"
                                Visibility="Collapsed" />
                        <Border x:Name="FocusKeyline" Margin="-1" CornerRadius="5"
                                BorderThickness="1" BorderBrush="{DynamicResource Border.FocusInner}"
                                Visibility="Collapsed" />

                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Radius.Control}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Control.FillHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Control.FillPressed}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                            <Setter TargetName="FocusKeyline" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Control.FillDisabled}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Control.BorderDisabled}" />
                            <Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The one accent filled button per surface. BasedOn the implicit style is required, not
        stylistic: without it this would silently lose the height, padding and margin above.
    -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource Accent.Fill}" />
        <Setter Property="Foreground" Value="{DynamicResource Accent.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Accent.Fill}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="FocusRing" Margin="-3" CornerRadius="{DynamicResource Radius.Focus}"
                                BorderThickness="2" BorderBrush="{DynamicResource Border.Focus}"
                                Visibility="Collapsed" />
                        <Border x:Name="FocusKeyline" Margin="-1" CornerRadius="5"
                                BorderThickness="1" BorderBrush="{DynamicResource Border.FocusInner}"
                                Visibility="Collapsed" />

                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Radius.Control}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Accent.Hover}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Accent.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Accent.Pressed}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Accent.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                            <Setter TargetName="FocusKeyline" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Control.FillDisabled}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Control.BorderDisabled}" />
                            <Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Narrow variant for Undo, Redo and Stop, which read as cramped at the full 96. -->
    <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="Padding" Value="10,0" />
    </Style>

    <!-- =================================================================== textbox -->

    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Body}" />
        <Setter Property="Height" Value="{DynamicResource Size.ControlHeight}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Background" Value="{DynamicResource Input.Fill}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Input.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{DynamicResource Text.Primary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent.Fill}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.Control}">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          BorderThickness="0" Background="Transparent" />

                            <!--
                                The accent underline on focus. Drawn as a separate element
                                rather than a thicker border so the control does not resize
                                when focus arrives.
                            -->
                            <Border x:Name="FocusUnderline" Height="2" VerticalAlignment="Bottom"
                                    Margin="1,0,1,0" CornerRadius="0,0,3,3"
                                    Background="{DynamicResource Accent.Fill}"
                                    Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Input.FillHover}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Input.BorderHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusUnderline" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Input.BorderHover}" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Surface.Sunken}" />
                            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Control.FillDisabled}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Control.BorderDisabled}" />
                            <Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================== combobox -->

    <Style x:Key="ComboToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Body}" />
        <Setter Property="Height" Value="{DynamicResource Size.ControlHeight}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Background" Value="{DynamicResource Control.Fill}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="FocusRing" Margin="-3" CornerRadius="{DynamicResource Radius.Focus}"
                                BorderThickness="2" BorderBrush="{DynamicResource Border.Focus}"
                                Visibility="Collapsed" />
                        <Border x:Name="FocusKeyline" Margin="-1" CornerRadius="5"
                                BorderThickness="1" BorderBrush="{DynamicResource Border.FocusInner}"
                                Visibility="Collapsed" />

                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Radius.Control}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="32" />
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="0"
                                                  Margin="{TemplateBinding Padding}"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  IsHitTestVisible="False"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left" />

                                <!-- Chevron drawn as geometry: a glyph would depend on a font that may not be present. -->
                                <Path x:Name="Chevron" Grid.Column="1"
                                      Data="M 0 0 L 5 5 L 10 0"
                                      Stroke="{DynamicResource Text.Secondary}" StrokeThickness="1.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsHitTestVisible="False" />

                                <ToggleButton Grid.ColumnSpan="2"
                                              Style="{StaticResource ComboToggle}"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Grid>
                        </Border>

                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Placement="Bottom"
                               VerticalOffset="4"
                               PopupAnimation="Fade"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Focusable="False">
                            <Border Background="{DynamicResource Surface.Overlay}"
                                    BorderBrush="{DynamicResource Border.Hairline}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.Card}"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Padding="4"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Control.FillHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                            <Setter TargetName="FocusKeyline" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Control.FillDisabled}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Control.BorderDisabled}" />
                            <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource Text.Disabled}" />
                            <Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Root" Background="Transparent"
                            CornerRadius="{DynamicResource Radius.Control}"
                            Padding="{TemplateBinding Padding}"
                            Margin="0,1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Row.Hover}" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Row.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Row.Selected}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================== checkbox -->

    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center">
                            <Border x:Name="FocusRing" Margin="-4" CornerRadius="{DynamicResource Radius.Focus}"
                                    BorderThickness="2" BorderBrush="{DynamicResource Border.Focus}"
                                    Visibility="Collapsed" />
                            <Border x:Name="Box"
                                    Background="{DynamicResource Input.Fill}"
                                    BorderBrush="{DynamicResource Border.Control}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.Small}" />
                            <Path x:Name="Check"
                                  Data="M 0 4 L 3.5 7.5 L 9.5 1"
                                  Stroke="{DynamicResource Accent.Text}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Visibility="Collapsed" />
                        </Grid>

                        <ContentPresenter Grid.Column="1" Margin="10,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent.Fill}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent.Fill}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Border.Strong}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent.Hover}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent.Hover}" />
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Control.FillDisabled}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Control.BorderDisabled}" />
                            <Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================================================== segmented control -->
    <!--
        Three mutually exclusive options as one control: a sunken track with a raised pill on
        the selected segment. Used for the appearance switch, where three radio buttons in a
        row would be both larger and less obviously a single choice.
    -->

    <Style x:Key="SegmentButton" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="Height" Value="26" />
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="FocusRing" Margin="-2" CornerRadius="5"
                                BorderThickness="2" BorderBrush="{DynamicResource Border.Focus}"
                                Visibility="Collapsed" />

                        <Border x:Name="Root" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Small}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Row.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Surface.Card}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Border.Hairline}" />
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SegmentTrack" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface.Sunken}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Hairline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
        <Setter Property="Padding" Value="2" />
    </Style>

    <!-- ==================================================================== slider -->

    <Style x:Key="SliderThumb" TargetType="Thumb">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="20" Height="20">
                        <Ellipse x:Name="Outer" Fill="{DynamicResource Control.Fill}"
                                 Stroke="{DynamicResource Border.Control}" StrokeThickness="1" />
                        <Ellipse x:Name="Inner" Width="10" Height="10"
                                 Fill="{DynamicResource Accent.Fill}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Inner" Property="Width" Value="12" />
                            <Setter TargetName="Inner" Property="Height" Value="12" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Inner" Property="Width" Value="8" />
                            <Setter TargetName="Inner" Property="Height" Value="8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="Height" Value="32" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                Background="{DynamicResource Surface.Sunken}"
                                BorderBrush="{DynamicResource Border.Hairline}" BorderThickness="1" />

                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False"
                                              Margin="0" MinWidth="0" Height="4" Cursor="Arrow">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                    Background="{DynamicResource Accent.Fill}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False"
                                              Margin="0" MinWidth="0" Height="4" Cursor="Arrow">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" Height="20" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ scrollbars -->
    <!--
        A static 12px bar rather than the overlay that expands on hover. The expanding version
        needs VisualStateManager animation on a fully custom template and is by far the most
        expensive item here relative to how much it matters.
    -->

    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Root" CornerRadius="3" Margin="3"
                            Background="{DynamicResource Scroll.Thumb}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Scroll.ThumbHover}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Scroll.ThumbHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The page-scroll regions above and below the thumb. Invisible, but they must stay hit testable. -->
    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="{DynamicResource Scroll.Track}" />
        <Setter Property="Width" Value="{DynamicResource Size.ScrollBar}" />
        <Setter Property="MinWidth" Value="{DynamicResource Size.ScrollBar}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="{DynamicResource Size.ScrollBar}" />
                <Setter Property="MinHeight" Value="{DynamicResource Size.ScrollBar}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Templated only to replace the system coloured square where the two bars meet. -->
    <Style TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- The PART_ name is not decorative: ScrollViewer looks it up by name. -->
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                Grid.Row="0" Grid.Column="0"
                                                Margin="{TemplateBinding Padding}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}" />

                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Row="0" Grid.Column="1"
                                   Orientation="Vertical"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />

                        <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Grid.Column="0"
                                   Orientation="Horizontal"
                                   Value="{TemplateBinding HorizontalOffset}"
                                   Maximum="{TemplateBinding ScrollableWidth}"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================== list -->

    <Style TargetType="ListView">
        <Setter Property="Background" Value="{DynamicResource Surface.Card}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Hairline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Body}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListView">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.Card}"
                            SnapsToDevicePixels="True">
                        <!-- Clipped so rows cannot paint over the rounded corners. -->
                        <Border CornerRadius="{DynamicResource Radius.Card}" ClipToBounds="True" Padding="1">
                            <!--
                                This ScrollViewer style is load bearing and is NOT interchangeable
                                with a plain ScrollViewer. GridView draws its column headers from a
                                GridViewHeaderRowPresenter that lives inside this style's template,
                                and nowhere else.

                                An implicit ListView style outranks the theme style WPF would
                                otherwise use for a ListView whose View is a GridView, so
                                retemplating without this key silently deletes every column
                                header while leaving the rows working perfectly.
                            -->
                            <ScrollViewer Padding="0"
                                          Style="{DynamicResource {x:Static GridView.GridViewScrollViewerStyleKey}}">
                                <ItemsPresenter SnapsToDevicePixels="True" />
                            </ScrollViewer>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListViewItem">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinHeight" Value="{DynamicResource Size.RowHeight}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <!--
                        Vertical margin only. A horizontal inset would shift every cell
                        relative to its column header, which sits outside the row and cannot
                        be inset to match.
                    -->
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            Margin="0,1" Padding="{TemplateBinding Padding}"
                            CornerRadius="{DynamicResource Radius.Control}">
                        <GridViewRowPresenter VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              Columns="{TemplateBinding GridView.ColumnCollection}" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Row.Hover}" />
                        </Trigger>

                        <!--
                            Selection triggers come after hover deliberately. WPF applies matching
                            triggers in order, so a selected row that also has the pointer over it
                            must have selection win, not hover.
                        -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Row.Selected}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="Selector.IsSelectionActive" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Row.SelectedInactive}" />
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                            <Setter TargetName="Root" Property="BorderThickness" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        GridViewColumnHeader is templated in three roles. Styling only the normal one leaves an
        unthemed grey block floating under the pointer whenever a header is dragged, and an
        unthemed gripper between every pair of columns.
    -->
    <Style x:Key="GridHeaderGripper" TargetType="Thumb">
        <Setter Property="Width" Value="9" />
        <Setter Property="Background" Value="{DynamicResource Grid.Line}" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent" Padding="4,0">
                        <Rectangle Width="1" Fill="{TemplateBinding Background}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="GridViewColumnHeader">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Caption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="Background" Value="{DynamicResource Grid.Header}" />
        <Setter Property="Height" Value="{DynamicResource Size.GridHeaderHeight}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Grid>
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Border.Hairline}"
                                BorderThickness="0,0,0,1">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <Thumb x:Name="PART_HeaderGripper"
                               HorizontalAlignment="Right"
                               Style="{StaticResource GridHeaderGripper}" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Row.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Control.FillPressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <!-- The filler header to the right of the last column: no content, no gripper. -->
            <Trigger Property="Role" Value="Padding">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GridViewColumnHeader">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource Border.Hairline}"
                                    BorderThickness="0,0,0,1" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>

            <!-- The block that follows the pointer while a header is being dragged. -->
            <Trigger Property="Role" Value="Floating">
                <Setter Property="Opacity" Value="0.8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GridViewColumnHeader">
                            <Border Background="{DynamicResource Surface.Overlay}"
                                    BorderBrush="{DynamicResource Border.Control}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.Control}">
                                <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- =============================================================== tabs as nav -->
    <!--
        The tab strip sits on the left and reads as a navigation pane, which is the register
        Windows 11 Settings uses for exactly this shape of app. Selection is an accent bar at
        the leading edge plus a filled row, not a raised folder tab.
    -->

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{DynamicResource Surface.Page}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="TabStripPlacement" Value="Left" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TabPanel IsItemsHost="True"
                                      Width="{DynamicResource Size.NavWidth}"
                                      Margin="8,8,8,8"
                                      KeyboardNavigation.TabIndex="1" />
                        </ScrollViewer>

                        <!--
                            The PART_ name is required, not decorative. TabControlAutomationPeer
                            locates the selected tab's content by looking this name up in the
                            template; without it the content still renders, and every control
                            inside it is invisible to UI Automation. That means a screen reader
                            sees the navigation and the status bar and nothing else, and it is
                            silent enough to survive a visual review — it was found by an
                            automation script reporting zero rows in a list that was plainly
                            on screen.
                        -->
                        <ContentPresenter x:Name="PART_SelectedContentHost"
                                          Grid.Column="1"
                                          ContentSource="SelectedContent"
                                          Margin="{TemplateBinding Padding}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="Height" Value="{DynamicResource Size.NavItemHeight}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid Margin="0,1">
                        <Border x:Name="FocusRing" Margin="-2" CornerRadius="{DynamicResource Radius.Focus}"
                                BorderThickness="2" BorderBrush="{DynamicResource Border.Focus}"
                                Visibility="Collapsed" />

                        <Border x:Name="Root" Background="Transparent"
                                CornerRadius="{DynamicResource Radius.Control}">
                            <Grid>
                                <Border x:Name="Indicator"
                                        Width="3" Height="18" CornerRadius="2"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Margin="3,0,0,0"
                                        Background="{DynamicResource Accent.Fill}"
                                        Visibility="Collapsed" />

                                <ContentPresenter x:Name="Label"
                                                  ContentSource="Header"
                                                  Margin="16,0,10,0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  RecognizesAccessKey="True"
                                                  TextBlock.Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Row.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Row.Selected}" />
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ group card -->

    <Style TargetType="GroupBox">
        <Setter Property="Background" Value="{DynamicResource Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Hairline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Padding" Value="{DynamicResource Space.CardPadding}" />
        <Setter Property="Margin" Value="{DynamicResource Space.CardGap}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.Card}"
                            Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <!--
                                The header is a plain heading inside the card, not the notched
                                label cut into the border that the stock template draws. That
                                notch is the single most dated element in the old window.
                            -->
                            <ContentPresenter DockPanel.Dock="Top"
                                              ContentSource="Header"
                                              Margin="0,0,0,12"
                                              TextBlock.FontFamily="{DynamicResource Font.Display}"
                                              TextBlock.FontSize="{DynamicResource Font.Subtitle}"
                                              TextBlock.FontWeight="SemiBold"
                                              TextBlock.Foreground="{DynamicResource Text.Primary}" />
                            <ContentPresenter />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ status bar -->

    <Style TargetType="StatusBar">
        <Setter Property="Background" Value="{DynamicResource Surface.Card}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Caption}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="StatusBar">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Border.Hairline}"
                            BorderThickness="0,1,0,0"
                            Padding="16,0">
                        <Grid Height="30">
                            <ItemsPresenter />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="StatusBarItem">
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="StatusBarItem">
                    <ContentPresenter VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================= separator -->

    <!--
        Always a vertical rule: the only separators in this app divide groups of toolbar
        buttons. An explicit height is required because these sit in a WrapPanel, which gives
        a child its desired size rather than stretching it, and a Border with no content
        desires no height at all.
    -->
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource Border.Hairline}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Width="1" Height="20" Margin="6,0" VerticalAlignment="Center"
                            Background="{DynamicResource Border.Hairline}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =================================================================== tooltip -->
    <!--
        Popups render outside the window's visual tree and inherit nothing from it, which is why
        this and the ComboBox popup and the context menu all have to be styled from
        Application.Resources. Style them at the window level instead and they stay Aero2 light
        in dark mode, a bug that only surfaces when somebody hovers a button.
    -->

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Surface.Overlay}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Caption}" />
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Border.Hairline}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Control}"
                            Padding="10,7">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================== context menu -->

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource Surface.Overlay}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Body}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Border.Hairline}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Card}"
                            Padding="4">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Root" Background="Transparent"
                            CornerRadius="{DynamicResource Radius.Control}"
                            Padding="{TemplateBinding Padding}"
                            Margin="0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" ContentSource="Header" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Margin="20,0,0,0"
                                       Text="{TemplateBinding InputGestureText}"
                                       Foreground="{DynamicResource Text.Tertiary}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Row.Hover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================================================= cursor preview -->
    <!--
        A deliberately theme-independent mid grey, which is the one decision here worth
        explaining. Cursors come in every colour, and two of them are awkward: most are white
        with a black outline, and a legacy inverting cursor such as the text I-beam has no
        colour at all and is drawn black. A light backdrop hides the black ones and a dark
        backdrop hides the white ones, so following the theme would make the preview useless
        in one mode or the other. Mid grey carries both, which is why image editors use it.
    -->
    <DrawingBrush x:Key="Preview.Checkerboard" TileMode="Tile"
                  Viewport="0,0,10,10" ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#B0B0B0">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,10,10" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#9C9C9C">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="0,0,5,5" />
                            <RectangleGeometry Rect="5,5,5,5" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <Style x:Key="PreviewPlate" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Preview.Checkerboard}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Small}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ============================================================ named helpers -->
    <!--
        These keys already existed and are referenced from MainWindow.xaml, so they keep their
        names. The Style object itself resolves once through StaticResource, but the brushes
        inside it are DynamicResource and still follow a theme change.
    -->

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Display}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Title}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Display}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Subtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="LineHeight" Value="20" />
    </Style>

    <Style x:Key="Warning" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Status.Warning}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="LineHeight" Value="20" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="{DynamicResource Space.FieldGap}" />
        <Setter Property="MinWidth" Value="{DynamicResource Size.LabelColumn}" />
    </Style>

    <!-- The bordered readout panels in the two detail columns. -->
    <Style x:Key="InfoCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface.Sunken}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Hairline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
        <Setter Property="Padding" Value="{DynamicResource Space.InfoPadding}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="WarningCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Status.WarningSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Status.WarningBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
        <Setter Property="Padding" Value="{DynamicResource Space.InfoPadding}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="MonoText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Mono.Size}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Mono}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
