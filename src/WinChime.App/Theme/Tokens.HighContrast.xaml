<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        High contrast tokens.

        Merged instead of the light or dark set whenever Windows is in a high contrast scheme.
        Someone running high contrast has chosen those colours deliberately, usually because they
        need them, so painting a hand-picked palette over the top is an accessibility regression
        rather than a cosmetic preference.

        Every value defers to SystemColors, so the scheme the user picked is the scheme they get.
        The control templates in Controls.xaml still apply: they are flat fills and single pixel
        borders, which is exactly what a high contrast scheme wants, and keeping them means the
        rounded corners and sensible control sizes survive.

        Key for key identical to Tokens.Light.xaml. ThemeTokenTests asserts that across all three
        files, because a key present in one and missing from another resolves to nothing and
        paints transparent rather than failing.
    -->

    <!-- ================================================================ surfaces -->

    <SolidColorBrush x:Key="Surface.Page" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Surface.Card" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Surface.Sunken" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="Surface.Overlay" Color="{x:Static SystemColors.WindowColor}" />

    <!-- ================================================================= borders -->

    <SolidColorBrush x:Key="Border.Hairline" Color="{x:Static SystemColors.ActiveBorderColor}" />
    <SolidColorBrush x:Key="Border.Control" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Border.Strong" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Border.Focus" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Border.FocusInner" Color="{x:Static SystemColors.WindowColor}" />

    <!-- ==================================================================== text -->

    <SolidColorBrush x:Key="Text.Primary" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Text.Secondary" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Text.Tertiary" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Text.Disabled" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="Text.Mono" Color="{x:Static SystemColors.WindowTextColor}" />

    <!-- ================================================================== accent -->
    <!-- Not overridden from the Windows accent in high contrast. See ThemeManager.ApplyAccent. -->

    <SolidColorBrush x:Key="Accent.Fill" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Accent.Hover" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Accent.Pressed" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Accent.Text" Color="{x:Static SystemColors.HighlightTextColor}" />
    <SolidColorBrush x:Key="Accent.Subtle" Color="{x:Static SystemColors.HighlightColor}" />

    <!-- ================================================================ controls -->

    <SolidColorBrush x:Key="Control.Fill" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="Control.FillHover" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Control.FillPressed" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Control.FillDisabled" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="Control.BorderDisabled" Color="{x:Static SystemColors.GrayTextColor}" />

    <!-- =================================================================== input -->

    <SolidColorBrush x:Key="Input.Fill" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Input.FillHover" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Input.Border" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Input.BorderHover" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Input.BorderError" Color="{x:Static SystemColors.WindowTextColor}" />

    <!-- ==================================================================== list -->

    <SolidColorBrush x:Key="Row.Hover" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Row.Selected" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Row.SelectedInactive" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="Grid.Header" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="Grid.Line" Color="{x:Static SystemColors.ActiveBorderColor}" />

    <!-- ============================================================== scrollbars -->

    <SolidColorBrush x:Key="Scroll.Track" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="Scroll.Thumb" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Scroll.ThumbHover" Color="{x:Static SystemColors.HighlightColor}" />

    <!-- ================================================================== status -->

    <SolidColorBrush x:Key="Status.Success" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Status.Warning" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Status.WarningSurface" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="Status.WarningBorder" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Status.Danger" Color="{x:Static SystemColors.WindowTextColor}" />

    <!-- =================================================================== swatch -->

    <SolidColorBrush x:Key="Swatch.Border" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Swatch.BorderSelected" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Swatch.Keyline" Color="{x:Static SystemColors.WindowColor}" />

</ResourceDictionary>
