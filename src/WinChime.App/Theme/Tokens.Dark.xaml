<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">

    <!--
        Dark theme tokens. Key for key identical to Tokens.Light.xaml; see the notes there.

        Not an inversion of the light theme, and the places it departs are the ones that matter:

        - The card is LIGHTER than the page, not darker. Depth in a dark interface reads as
          proximity to the light source, so the raised surface is the paler one. Inverting the
          light theme would push cards darker and make them read as holes.
        - Primary text is off white, not #FFFFFF. Pure white on a dark ground haloes and is
          tiring to read at body size.
        - Borders get lighter rather than darker, because contrast against a dark surface comes
          from adding light, not removing it.
        - Status colours are not the light theme's colours dimmed. A dark amber or a deep red
          disappears on a dark ground, so both are replaced with light tints that carry.
    -->

    <!-- ================================================================ surfaces -->

    <SolidColorBrush x:Key="Surface.Page" Color="#1E1E1E" po:Freeze="True" />
    <SolidColorBrush x:Key="Surface.Card" Color="#272727" po:Freeze="True" />
    <SolidColorBrush x:Key="Surface.Sunken" Color="#1A1A1A" po:Freeze="True" />
    <SolidColorBrush x:Key="Surface.Overlay" Color="#2C2C2C" po:Freeze="True" />

    <!-- ================================================================= borders -->

    <SolidColorBrush x:Key="Border.Hairline" Color="#383838" po:Freeze="True" />
    <SolidColorBrush x:Key="Border.Control" Color="#8A8A8A" po:Freeze="True" />
    <SolidColorBrush x:Key="Border.Strong" Color="#9A9A9A" po:Freeze="True" />

    <SolidColorBrush x:Key="Border.Focus" Color="#F4F4F4" po:Freeze="True" />
    <SolidColorBrush x:Key="Border.FocusInner" Color="#1A1A1A" po:Freeze="True" />

    <!-- ==================================================================== text -->

    <SolidColorBrush x:Key="Text.Primary" Color="#F4F4F4" po:Freeze="True" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#C8C8C8" po:Freeze="True" />

    <!-- 6.14:1 on card, 7.15:1 on the sunken surface. -->
    <SolidColorBrush x:Key="Text.Tertiary" Color="#A6A6A6" po:Freeze="True" />

    <SolidColorBrush x:Key="Text.Disabled" Color="#6E6E6E" po:Freeze="True" />
    <SolidColorBrush x:Key="Text.Mono" Color="#D8D8D8" po:Freeze="True" />

    <!-- ================================================================== accent -->
    <!-- Overwritten at startup from the Windows accent. See ThemeManager.ApplyAccent. -->

    <SolidColorBrush x:Key="Accent.Fill" Color="#0078D7" po:Freeze="True" />
    <SolidColorBrush x:Key="Accent.Hover" Color="#1485DB" po:Freeze="True" />
    <SolidColorBrush x:Key="Accent.Pressed" Color="#2991DF" po:Freeze="True" />
    <SolidColorBrush x:Key="Accent.Text" Color="#000000" po:Freeze="True" />

    <SolidColorBrush x:Key="Accent.Subtle" Color="#1C3446" po:Freeze="True" />

    <!-- ================================================================ controls -->

    <SolidColorBrush x:Key="Control.Fill" Color="#333333" po:Freeze="True" />
    <SolidColorBrush x:Key="Control.FillHover" Color="#3B3B3B" po:Freeze="True" />
    <SolidColorBrush x:Key="Control.FillPressed" Color="#2C2C2C" po:Freeze="True" />
    <SolidColorBrush x:Key="Control.FillDisabled" Color="#2A2A2A" po:Freeze="True" />
    <SolidColorBrush x:Key="Control.BorderDisabled" Color="#3D3D3D" po:Freeze="True" />

    <!-- =================================================================== input -->

    <SolidColorBrush x:Key="Input.Fill" Color="#2C2C2C" po:Freeze="True" />
    <SolidColorBrush x:Key="Input.FillHover" Color="#323232" po:Freeze="True" />
    <SolidColorBrush x:Key="Input.Border" Color="#8A8A8A" po:Freeze="True" />
    <SolidColorBrush x:Key="Input.BorderHover" Color="#A6A6A6" po:Freeze="True" />

    <SolidColorBrush x:Key="Input.BorderError" Color="#FF99A4" po:Freeze="True" />

    <!-- ==================================================================== list -->

    <SolidColorBrush x:Key="Row.Hover" Color="#2F2F2F" po:Freeze="True" />
    <SolidColorBrush x:Key="Row.Selected" Color="#1C3446" po:Freeze="True" />
    <SolidColorBrush x:Key="Row.SelectedInactive" Color="#333333" po:Freeze="True" />
    <SolidColorBrush x:Key="Grid.Header" Color="#232323" po:Freeze="True" />
    <SolidColorBrush x:Key="Grid.Line" Color="#333333" po:Freeze="True" />

    <!-- ============================================================== scrollbars -->

    <SolidColorBrush x:Key="Scroll.Track" Color="#00000000" po:Freeze="True" />
    <SolidColorBrush x:Key="Scroll.Thumb" Color="#8A8A8A" po:Freeze="True" />
    <SolidColorBrush x:Key="Scroll.ThumbHover" Color="#A6A6A6" po:Freeze="True" />

    <!-- ================================================================== status -->

    <SolidColorBrush x:Key="Status.Success" Color="#6CCB5F" po:Freeze="True" />
    <SolidColorBrush x:Key="Status.Warning" Color="#FFC83D" po:Freeze="True" />
    <SolidColorBrush x:Key="Status.WarningSurface" Color="#332A12" po:Freeze="True" />
    <SolidColorBrush x:Key="Status.WarningBorder" Color="#4D4020" po:Freeze="True" />
    <SolidColorBrush x:Key="Status.Danger" Color="#FF99A4" po:Freeze="True" />

    <!-- =================================================================== swatch -->

    <SolidColorBrush x:Key="Swatch.Border" Color="#8A8A8A" po:Freeze="True" />
    <SolidColorBrush x:Key="Swatch.BorderSelected" Color="#F4F4F4" po:Freeze="True" />
    <SolidColorBrush x:Key="Swatch.Keyline" Color="#1A1A1A" po:Freeze="True" />

</ResourceDictionary>
