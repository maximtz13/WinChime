<Application x:Class="WinChime.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- No StartupUri: App.OnStartup branches on the command line so that the
         play-chime and elevated-op switches run headless without creating a window. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <!--
                    The token set. ThemeManager REPLACES this entry at startup with the light,
                    dark or high contrast set, so it must stay the only dictionary whose path
                    begins with Theme/Tokens. Declaring the light set here rather than leaving
                    the slot empty is what keeps the XAML designer usable.
                -->
                <ResourceDictionary Source="/Theme/Tokens.Light.xaml" />

                <ResourceDictionary Source="/Theme/Geometry.xaml" />
                <ResourceDictionary Source="/Theme/Controls.xaml" />

            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
