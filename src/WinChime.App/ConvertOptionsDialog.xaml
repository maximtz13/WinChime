<Window x:Class="WinChime.App.ConvertOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Convert audio" SizeToContent="Height" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="16">

        <TextBlock x:Name="SourceText" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock x:Name="ExplanationText" TextWrapping="Wrap" Foreground="#666666" Margin="0,0,0,14" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
            <CheckBox x:Name="TrimCheck" Content="Trim to" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="TrimSecondsBox" Width="48" Text="10" VerticalAlignment="Center" />
            <TextBlock Text="seconds" VerticalAlignment="Center" Margin="6,0,0,0" />
        </StackPanel>
        <TextBlock Text="A short fade is applied at the cut, so trimming does not leave an audible click."
                   TextWrapping="Wrap" Foreground="#666666" Margin="0,0,0,12" />

        <CheckBox x:Name="NormaliseCheck" Content="Even out the volume" Margin="0,0,0,2" />
        <TextBlock Text="Scales the sound so its loudest point matches other system sounds. Useful when a clip is noticeably quieter or louder than everything else."
                   TextWrapping="Wrap" Foreground="#666666" Margin="0,0,0,4" />

        <TextBlock x:Name="OutputText" TextWrapping="Wrap" Foreground="#666666" Margin="0,10,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Convert" IsDefault="True" Click="Ok_Click" />
            <Button Content="Cancel" IsCancel="True" Margin="0" />
        </StackPanel>

    </StackPanel>
</Window>
